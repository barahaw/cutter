# AI-Powered Video Fixer - Environment Configuration
# Copy this file to .env and fill in your Gemini API key.
# Note: In a packaged Windows application, place .env in the same directory as the executable.

# Google Gemini API Key (Obtain from https://aistudio.google.com/)
GEMINI_API_KEY=your_api_key_here

# Gemini Model Identifier (e.g., gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Enable AI-assisted diagnostic recommendations (true/false)
AI_ENABLED=true
